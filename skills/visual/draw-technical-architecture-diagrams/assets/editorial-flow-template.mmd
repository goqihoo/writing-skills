flowchart LR
    source["Source component"] -->|request| target["Focal component"]
    target -.->|event| consumer["Async consumer"]

    classDef normal fill:#FFFFFF,stroke:#CBD5E1,color:#0F172A,stroke-width:1.5px;
    classDef primary fill:#EFF6FF,stroke:#2563EB,color:#0F172A,stroke-width:2px;
    class source,consumer normal;
    class target primary;
    linkStyle default stroke:#94A3B8,stroke-width:1.5px;
    linkStyle 0 stroke:#2563EB,stroke-width:2.25px;
    linkStyle 1 stroke:#D97706,stroke-width:1.75px,stroke-dasharray:7 6;
